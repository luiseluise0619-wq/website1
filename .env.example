# =============================================================================
# K-SOHO GLOBAL — 환경 변수
# 이 파일을 .env.local 로 복사해 사용하세요. 실제 키는 커밋하지 마세요.
# =============================================================================

# ---- 저장소 -----------------------------------------------------------------
# 페이지/이벤트 JSON 저장 경로 (기본: ./.data)
PAGE_STORE_DIR=./.data
ANALYTICS_STORE_DIR=./.data

# ---- 자동 번역 ---------------------------------------------------------------
# 우선 사용할 제공자: deepl | google | tolgee (기본 deepl, 실패 시 자동 폴백)
TRANSLATION_PROVIDER=deepl

# DeepL — 한/일/중 품질 최상. 태국어·베트남어는 미지원이라 자동으로 Google 로 폴백된다.
# 무료 키는 ':fx' 로 끝나며 엔드포인트가 자동 전환된다.
DEEPL_API_KEY=

# Google Cloud Translation — 6개 언어 전부 지원. 폴백 경로로 반드시 설정 권장.
GOOGLE_TRANSLATE_API_KEY=

# Tolgee — 셀프호스팅 시 DeepL/Google 키를 Tolgee 에만 등록하고 여기로 프록시할 수 있다.
# 번역 이력·검수 상태가 Tolgee UI 에 남는 것이 장점.
TOLGEE_API_URL=https://tolgee.your-domain.com
TOLGEE_API_KEY=
NEXT_PUBLIC_TOLGEE_API_URL=
NEXT_PUBLIC_TOLGEE_API_KEY=

# ---- 분석 --------------------------------------------------------------------
# PostHog (셀프호스팅 가능) — 히트맵 / 세션 리플레이 / 퍼널
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Umami (선택) — 가벼운 병행 수단
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# GA4 / Mixpanel (선택)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
