# =============================================================================
# K-SOHO GLOBAL — 환경 변수
# 이 파일을 .env.local 로 복사해 사용하세요. 실제 키는 커밋하지 마세요.
# =============================================================================

# ---- 저장소 -----------------------------------------------------------------
# Postgres 연결 문자열. 설정하면 파일 대신 DB 를 사용한다.
# Vercel 에서 Storage(Neon/Supabase)를 연결하면 자동 주입된다.
# 서버리스에서는 풀러(pgbouncer) 연결 문자열 사용을 권장한다.
POSTGRES_URL=
# DATABASE_URL / POSTGRES_PRISMA_URL 도 인식한다.
POSTGRES_POOL_MAX=3

# 페이지/이벤트 JSON 저장 경로 (기본: ./.data)
PAGE_STORE_DIR=./.data
ANALYTICS_STORE_DIR=./.data

# ---- 관리자 인증 -------------------------------------------------------------
# 프로덕션에서 이 값이 없으면 모든 쓰기(저장/발행/번역)가 차단된다.
ADMIN_PASSWORD=
# 세션 서명 키(권장). 없으면 ADMIN_PASSWORD 를 키로 사용한다.
ADMIN_SESSION_SECRET=

# ---- 사이트 ------------------------------------------------------------------
# sitemap / hreflang 절대경로에 사용. 미설정 시 Vercel 도메인을 자동 사용.
# SITE_URL 은 런타임에 읽으므로 커스텀 도메인을 붙인 뒤 재빌드 없이 반영된다.
SITE_URL=
# 클라이언트에서도 도메인이 필요할 때만 사용(빌드 시점에 번들에 박힌다).
NEXT_PUBLIC_SITE_URL=

# ---- 자동 번역 ---------------------------------------------------------------
# 우선 사용할 제공자: deepl | google | libretranslate | ollama | tolgee
# 기본 deepl. 실패하거나 미설정이면 위 순서대로 자동 폴백한다.
# 유료 API 를 아예 쓰지 않으려면 libretranslate 로 두고 아래 LIBRETRANSLATE_URL 만 채우면 된다.
TRANSLATION_PROVIDER=deepl

# DeepL — 한/일/중 품질 최상. 태국어·베트남어는 미지원이라 자동으로 Google 로 폴백된다.
# 무료 키는 ':fx' 로 끝나며 엔드포인트가 자동 전환된다.
DEEPL_API_KEY=
# 사내 프록시나 테스트 목 서버로 보낼 때만 지정 (미지정 시 DeepL 공식 엔드포인트)
DEEPL_API_URL=

# Google Cloud Translation — 6개 언어 전부 지원. 폴백 경로로 반드시 설정 권장.
GOOGLE_TRANSLATE_API_KEY=
# 사내 프록시나 테스트 목 서버로 보낼 때만 지정
GOOGLE_TRANSLATE_API_URL=

# LibreTranslate (AGPL, 오픈소스) — 직접 띄우면 키도 한도도 비용도 없다.
#   docker run -d -p 5000:5000 libretranslate/libretranslate
# 원문이 외부로 나가지 않는 것도 장점. 해당 언어 모델이 없으면 400 → 다음 제공자로 폴백.
LIBRETRANSLATE_URL=
# 공개 인스턴스를 쓸 때만 필요 (직접 띄운 서버는 보통 불필요)
LIBRETRANSLATE_API_KEY=

# Ollama (MIT, 로컬 LLM) — 역시 무료·무제한. 마케팅 카피 문맥에 강하다.
#   ollama serve && ollama pull qwen2.5:7b
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b

# Tolgee — 셀프호스팅 시 DeepL/Google 키를 Tolgee 에만 등록하고 여기로 프록시할 수 있다.
# 번역 이력·검수 상태가 Tolgee UI 에 남는 것이 장점.
# 주의: 서버에서만 사용한다. NEXT_PUBLIC_ 접두사를 붙이면 키가 모든 방문자에게 노출된다.
TOLGEE_API_URL=https://tolgee.your-domain.com
TOLGEE_API_KEY=

# ---- 정적 HTML 내보내기 -------------------------------------------------------
# 에디터의 [HTML 내보내기] 는 발행된 페이지를 zip 으로 뽑아 준다.
# 압축을 풀어 웹호스팅 문서 루트에 그대로 올리면 Node 없이 그대로 뜬다.
#
# 산출물에는 /api 가 없다. 정적 사본에서 들어온 문의와 방문 분석을 계속 받으려면
# 두 가지가 모두 필요하다:
#   1) SITE_URL — 산출물에 심을 원본 주소 (위 '사이트' 항목)
#   2) STATIC_SITE_ORIGINS — 정적 사본이 올라간 도메인 (교차 출처 허용 목록)
# 비워 두면 정적 사본의 문의 폼은 "접수할 수 없습니다"를 보여 주고 분석은 꺼진다.
# 여기 적은 도메인만 허용된다 — 비우면 교차 출처 요청은 전부 막힌다.
STATIC_SITE_ORIGINS=https://www.your-domain.co.kr

# ---- 분석 --------------------------------------------------------------------
# PostHog (셀프호스팅 가능) — 히트맵 / 세션 리플레이 / 퍼널
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Umami (선택) — 가벼운 병행 수단. 둘 다 있어야 스크립트가 주입된다.
NEXT_PUBLIC_UMAMI_URL=https://umami.your-domain.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# GA4 / Mixpanel (선택)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
